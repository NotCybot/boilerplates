OAUTH_CLIENT_ID=YourID
OAUTH_CLIENT_SECRET=YourSecret
OAUTH_PROVIDER_NAME=authentik
OPENID_PROVIDER_URL=https://tld.com/application/o/<application-slug>/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://tld.com/oauth/oidc/callback
WEBUI_URL=https://tld.com
ENABLE_OAUTH_SIGNUP=true
ENABLE_LOGIN_FORM=false
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true